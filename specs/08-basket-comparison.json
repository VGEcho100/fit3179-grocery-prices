{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": 720,
  "height": 400,
  "data": {
    "url": "data/clean/choice_state_basket_jun2026.csv"
  },
  "transform": [
    {
      "filter": "datum.available === true || datum.available === 'True'"
    },
    {
      "calculate": "toNumber(datum.basket_price_aud)",
      "as": "basket_price"
    }
  ],
  "layer": [
    {
      "transform": [
        {
          "filter": "datum.supermarket === 'Aldi'"
        },
        {
          "aggregate": [
            {
              "op": "min",
              "field": "basket_price",
              "as": "aldi_low"
            },
            {
              "op": "max",
              "field": "basket_price",
              "as": "aldi_high"
            },
            {
              "op": "count",
              "as": "aldi_states"
            }
          ]
        },
        {
          "calculate": "'Aldi was cheapest in all ' + datum.aldi_states + ' states it serves: $' + format(datum.aldi_low, '.0f') + '–$' + format(datum.aldi_high, '.0f')",
          "as": "note"
        }
      ],
      "layer": [
        {
          "mark": {
            "type": "rect",
            "color": "#1b5ca8",
            "opacity": 0.1
          },
          "encoding": {
            "x": {
              "type": "quantitative",
              "field": "aldi_low",
              "scale": {
                "domain": [
                  64,
                  124
                ],
                "nice": false,
                "zero": false
              }
            },
            "x2": {
              "field": "aldi_high"
            }
          }
        },
        {
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "bottom",
            "dy": -8,
            "fontSize": 12.5,
            "fontWeight": 700,
            "color": "#1b5ca8"
          },
          "encoding": {
            "x": {
              "type": "quantitative",
              "field": "aldi_low",
              "scale": {
                "domain": [
                  64,
                  124
                ],
                "nice": false,
                "zero": false
              }
            },
            "y": {
              "value": 0
            },
            "text": {
              "field": "note"
            }
          }
        }
      ]
    },
    {
      "transform": [
        {
          "joinaggregate": [
            {
              "op": "min",
              "field": "basket_price",
              "as": "lowest_price"
            },
            {
              "op": "max",
              "field": "basket_price",
              "as": "highest_price"
            }
          ],
          "groupby": [
            "state"
          ]
        }
      ],
      "mark": {
        "type": "rule",
        "color": "#c7c0b2",
        "strokeWidth": 3
      },
      "encoding": {
        "y": {
          "field": "state",
          "type": "nominal",
          "title": "State or territory",
          "sort": [
            "ACT",
            "NSW",
            "NT",
            "QLD",
            "SA",
            "TAS",
            "VIC",
            "WA"
          ]
        },
        "x": {
          "field": "lowest_price",
          "type": "quantitative",
          "title": "17-item basket price (AUD)",
          "scale": {
            "domain": [
              64,
              124
            ],
            "nice": false,
            "zero": false
          },
          "axis": {
            "format": "$,.0f"
          }
        },
        "x2": {
          "field": "highest_price"
        }
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 150,
        "opacity": 0.95,
        "stroke": "#fffdf8",
        "strokeWidth": 1.4
      },
      "encoding": {
        "y": {
          "field": "state",
          "type": "nominal",
          "title": "State or territory",
          "sort": [
            "ACT",
            "NSW",
            "NT",
            "QLD",
            "SA",
            "TAS",
            "VIC",
            "WA"
          ]
        },
        "x": {
          "field": "basket_price",
          "type": "quantitative",
          "title": "17-item basket price (AUD)",
          "scale": {
            "domain": [
              64,
              124
            ],
            "nice": false,
            "zero": false
          },
          "axis": {
            "format": "$,.0f"
          }
        },
        "color": {
          "field": "supermarket",
          "type": "nominal",
          "title": "Supermarket",
          "scale": {
            "domain": [
              "Aldi",
              "Woolworths",
              "Coles",
              "IGA"
            ],
            "range": [
              "#1b5ca8",
              "#2f7d49",
              "#d64045",
              "#e4a525"
            ]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "columns": 4
          }
        },
        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "supermarket",
            "type": "nominal",
            "title": "Supermarket"
          },
          {
            "field": "basket_price",
            "type": "quantitative",
            "title": "Basket price",
            "format": "$,.2f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "joinaggregate": [
            {
              "op": "min",
              "field": "basket_price",
              "as": "lowest_price"
            },
            {
              "op": "max",
              "field": "basket_price",
              "as": "highest_price"
            }
          ],
          "groupby": [
            "state"
          ]
        },
        {
          "filter": "datum.basket_price === datum.highest_price"
        },
        {
          "calculate": "'$' + format(datum.highest_price - datum.lowest_price, '.2f') + ' gap'",
          "as": "gap_label"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 12,
        "fontSize": 12,
        "fontWeight": 700,
        "color": "#5e6c63"
      },
      "encoding": {
        "x": {
          "type": "quantitative",
          "field": "highest_price",
          "scale": {
            "domain": [
              64,
              124
            ],
            "nice": false,
            "zero": false
          }
        },
        "y": {
          "field": "state",
          "type": "nominal",
          "sort": [
            "ACT",
            "NSW",
            "NT",
            "QLD",
            "SA",
            "TAS",
            "VIC",
            "WA"
          ]
        },
        "text": {
          "field": "gap_label"
        }
      }
    }
  ],
  "config": {
    "background": null,
    "view": {
      "stroke": null
    },
    "font": "Source Sans 3",
    "axis": {
      "labelColor": "#5e6c63",
      "titleColor": "#17211b",
      "domainColor": "#cfc7b8",
      "gridColor": "#e8e2d6"
    },
    "legend": {
      "labelColor": "#49574e",
      "titleColor": "#17211b",
      "titleFontWeight": 700,
      "symbolStrokeWidth": 1
    }
  }
}
