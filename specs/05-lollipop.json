{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": 720,
  "height": 500,
  "data": {
    "url": "data/clean/abs_food_australia_monthly.csv"
  },
  "transform": [
    {
      "filter": "datum.measure === 'annual_percent_change' && toDate(datum.date) === toDate('2026-08-01') && indexof([\"Bread\",\"Breakfast cereals\",\"Beef and veal\",\"Lamb and goat\",\"Pork\",\"Poultry\",\"Fish and other seafood\",\"Milk\",\"Cheese\",\"Eggs\",\"Fruit\",\"Vegetables\",\"Coffee, tea and cocoa\",\"Waters, soft drinks and juices\",\"Snacks and confectionery\"], datum.category) >= 0"
    },
    {
      "calculate": "toNumber(datum.value)",
      "as": "annual_change"
    }
  ],
  "encoding": {
    "y": {
      "field": "category",
      "type": "nominal",
      "title": null,
      "sort": {
        "field": "annual_change",
        "order": "descending"
      },
      "axis": {
        "labelLimit": 190
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "strokeWidth": 2.5,
        "color": "#c9c2b5"
      },
      "encoding": {
        "x": {
          "field": "annual_change",
          "type": "quantitative",
          "title": "Annual price change (%)",
          "scale": {
            "domain": [
              -6,
              11
            ],
            "nice": false
          }
        },
        "x2": {
          "datum": 0
        }
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 115,
        "stroke": "#fffdf8",
        "strokeWidth": 1.2
      },
      "encoding": {
        "x": {
          "field": "annual_change",
          "type": "quantitative",
          "title": "Annual price change (%)",
          "scale": {
            "domain": [
              -6,
              11
            ],
            "nice": false
          }
        },
        "color": {
          "condition": {
            "test": "datum.annual_change < 0",
            "value": "#2f6f9f"
          },
          "value": "#df6d3a"
        },
        "tooltip": [
          {
            "field": "category",
            "type": "nominal",
            "title": "Category"
          },
          {
            "field": "annual_change",
            "type": "quantitative",
            "title": "Annual change",
            "format": ".1f"
          }
        ]
      }
    }
  ],
  "config": {
    "background": null,
    "view": {
      "stroke": null
    },
    "font": "Arial",
    "axis": {
      "labelColor": "#5e6c63",
      "titleColor": "#17211b",
      "domainColor": "#cfc7b8",
      "gridColor": "#e8e2d6"
    },
    "legend": {
      "labelColor": "#49574e",
      "titleColor": "#17211b",
      "titleFontWeight": 700,
      "symbolStrokeWidth": 1
    }
  }
}
