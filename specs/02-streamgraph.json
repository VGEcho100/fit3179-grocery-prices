{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": 720,
  "height": 390,
  "data": {
    "url": "data/clean/abs_food_australia_monthly.csv"
  },
  "transform": [
    {
      "filter": "datum.measure === 'contribution_to_all_groups_index' && indexof([\"Meals out and take away foods\",\"Food products n.e.c.\",\"Meat and seafoods\",\"Fruit and vegetables\",\"Bread and cereal products\",\"Non-alcoholic beverages\",\"Dairy and related products\"], datum.category) >= 0"
    },
    {
      "calculate": "toNumber(datum.value)",
      "as": "contribution"
    }
  ],
  "mark": {
    "type": "area",
    "interpolate": "monotone",
    "opacity": 0.9
  },
  "encoding": {
    "x": {
      "field": "date",
      "type": "temporal",
      "title": "Month",
      "axis": {
        "format": "%b %Y",
        "tickCount": 6,
        "labelAngle": -35
      }
    },
    "y": {
      "field": "contribution",
      "type": "quantitative",
      "title": "CPI contribution (index points)",
      "stack": "center",
      "axis": {
        "labels": false,
        "ticks": false,
        "domain": false,
        "title": null
      }
    },
    "color": {
      "field": "category",
      "type": "nominal",
      "title": "Food category",
      "scale": {
        "scheme": "tableau20"
      },
      "legend": {
        "orient": "bottom",
        "columns": 2,
        "labelLimit": 220
      }
    },
    "order": {
      "field": "category_order",
      "type": "quantitative"
    },
    "tooltip": [
      {
        "field": "date",
        "type": "temporal",
        "title": "Month",
        "format": "%B %Y"
      },
      {
        "field": "category",
        "type": "nominal",
        "title": "Category"
      },
      {
        "field": "contribution",
        "type": "quantitative",
        "title": "Contribution",
        "format": ".2f"
      }
    ]
  },
  "config": {
    "background": null,
    "view": {
      "stroke": null
    },
    "font": "Arial",
    "axis": {
      "labelColor": "#5e6c63",
      "titleColor": "#17211b",
      "domainColor": "#cfc7b8",
      "gridColor": "#e8e2d6"
    },
    "legend": {
      "labelColor": "#49574e",
      "titleColor": "#17211b",
      "titleFontWeight": 700,
      "symbolStrokeWidth": 1
    }
  }
}
