{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": 720,
  "height": 410,
  "data": {
    "url": "data/clean/abs_food_australia_monthly.csv"
  },
  "transform": [
    {
      "filter": "datum.measure === 'annual_percent_change' && month(toDate(datum.date)) === 7 && toDate(datum.date) >= toDate('2019-08-01') && indexof([\"Bread and cereal products\",\"Meat and seafoods\",\"Dairy and related products\",\"Fruit and vegetables\",\"Food products n.e.c.\",\"Non-alcoholic beverages\"], datum.category) >= 0"
    },
    {
      "calculate": "toNumber(datum.value)",
      "as": "annual_change"
    },
    {
      "calculate": "year(toDate(datum.date))",
      "as": "year"
    },
    {
      "window": [
        {
          "op": "rank",
          "as": "inflation_rank"
        }
      ],
      "sort": [
        {
          "field": "annual_change",
          "order": "descending"
        }
      ],
      "groupby": [
        "date"
      ]
    },
    {
      "calculate": "datum.category === 'Bread and cereal products' ? 'Bread & cereals' : datum.category === 'Meat and seafoods' ? 'Meat & seafood' : datum.category === 'Dairy and related products' ? 'Dairy' : datum.category === 'Fruit and vegetables' ? 'Fruit & vegetables' : datum.category === 'Food products n.e.c.' ? 'Other food' : 'Non-alcoholic drinks'",
      "as": "short_category"
    },
    {
      "calculate": "datum.inflation_rank + '  ' + datum.short_category",
      "as": "end_label"
    }
  ],
  "encoding": {
    "x": {
      "field": "year",
      "type": "quantitative",
      "title": "August each year",
      "scale": {
        "domain": [
          2019,
          2027.9
        ],
        "nice": false
      },
      "axis": {
        "values": [
          2019,
          2020,
          2021,
          2022,
          2023,
          2024,
          2025,
          2026
        ],
        "format": "d",
        "labelAngle": 0,
        "grid": false
      }
    },
    "y": {
      "field": "inflation_rank",
      "type": "ordinal",
      "title": "Position by annual price growth",
      "sort": "ascending",
      "axis": {
        "values": [
          1,
          2,
          3,
          4,
          5,
          6
        ],
        "labelExpr": "datum.value === 1 ? '1  HIGHEST' : datum.value === 6 ? '6  LOWEST' : '' + datum.value",
        "labelFontWeight": 700,
        "labelPadding": 10,
        "ticks": false,
        "domain": false,
        "grid": true,
        "gridColor": "#e8e2d6",
        "gridOpacity": 1
      }
    },
    "color": {
      "field": "category",
      "type": "nominal",
      "scale": {
        "domain": [
          "Bread and cereal products",
          "Dairy and related products",
          "Food products n.e.c.",
          "Fruit and vegetables",
          "Meat and seafoods",
          "Non-alcoholic beverages"
        ],
        "range": [
          "#4c78a8",
          "#f58518",
          "#e45756",
          "#72b7b2",
          "#4c9f4a",
          "#eabf26"
        ]
      },
      "legend": null
    },
    "tooltip": [
      {
        "field": "date",
        "type": "temporal",
        "title": "Period",
        "format": "August %Y"
      },
      {
        "field": "category",
        "type": "nominal",
        "title": "Food category"
      },
      {
        "field": "inflation_rank",
        "type": "ordinal",
        "title": "Position"
      },
      {
        "field": "annual_change",
        "type": "quantitative",
        "title": "Annual price change",
        "format": ".1f"
      }
    ]
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 3,
        "opacity": 0.72
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 280,
        "stroke": "#fffdf8",
        "strokeWidth": 2
      }
    },
    {
      "mark": {
        "type": "text",
        "font": "Source Sans 3",
        "fontSize": 11,
        "fontWeight": 700,
        "color": "#fffdf8"
      },
      "encoding": {
        "text": {
          "field": "inflation_rank",
          "type": "ordinal"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year === 2026"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 16,
        "font": "Source Sans 3",
        "fontSize": 12,
        "fontWeight": 700
      },
      "encoding": {
        "text": {
          "field": "end_label",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "background": null,
    "view": {
      "stroke": null
    },
    "font": "Source Sans 3",
    "axis": {
      "labelColor": "#5e6c63",
      "titleColor": "#17211b",
      "domainColor": "#cfc7b8",
      "gridColor": "#e8e2d6"
    }
  }
}
