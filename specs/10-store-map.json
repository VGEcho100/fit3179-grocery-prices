{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": 700,
  "height": 600,
  "projection": {
    "type": "mercator",
    "center": [
      145.106,
      -37.839
    ],
    "scale": 21000,
    "pointRadius": 2.6
  },
  "layer": [
    {
      "data": {
        "url": "data/clean/sa2_greater_melbourne.geojson?v=2",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#f0ece3",
        "stroke": "#d0c8b9",
        "strokeWidth": 0.35
      },
      "encoding": {
        "shape": {
          "field": "geometry",
          "type": "geojson"
        }
      }
    },
    {
      "data": {
        "url": "data/clean/supermarkets_greater_melbourne.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "params": [
        {
          "name": "brandSelection",
          "select": {
            "type": "point",
            "fields": [
              "brand_group"
            ]
          },
          "bind": "legend"
        }
      ],
      "transform": [
        {
          "calculate": "datum.properties.brand_group",
          "as": "brand_group"
        },
        {
          "calculate": "datum.properties.name",
          "as": "store_name"
        },
        {
          "calculate": "datum.properties.sa2_name_2021",
          "as": "sa2_name"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#fffdf8",
        "strokeWidth": 0.4
      },
      "encoding": {
        "shape": {
          "field": "geometry",
          "type": "geojson"
        },
        "color": {
          "field": "brand_group",
          "type": "nominal",
          "title": "Brand group",
          "scale": {
            "domain": [
              "Woolworths",
              "Coles",
              "Aldi",
              "IGA",
              "FoodWorks",
              "Other"
            ],
            "range": [
              "#2f7d49",
              "#d64045",
              "#1b5ca8",
              "#e4a525",
              "#7b4da3",
              "#7e8881"
            ]
          },
          "legend": {
            "orient": "bottom",
            "columns": 3,
            "symbolType": "circle"
          }
        },
        "opacity": {
          "condition": {
            "param": "brandSelection",
            "value": 0.92
          },
          "value": 0.08
        },
        "tooltip": [
          {
            "field": "store_name",
            "type": "nominal",
            "title": "Store"
          },
          {
            "field": "brand_group",
            "type": "nominal",
            "title": "Brand group"
          },
          {
            "field": "sa2_name",
            "type": "nominal",
            "title": "SA2"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "lon": 144.9631,
            "lat": -37.8136,
            "label": "Melbourne CBD\n22 supermarkets in 3 SA2s",
            "side": "left",
            "marker": true
          },
          {
            "lon": 145.2231,
            "lat": -37.9832,
            "label": "Dandenong North\n23 stores, the most of any SA2",
            "side": "right",
            "marker": true
          },
          {
            "lon": 144.66,
            "lat": -38.08,
            "label": "Port Phillip Bay",
            "side": "right",
            "marker": false
          }
        ]
      },
      "layer": [
        {
          "mark": {
            "type": "circle",
            "size": 46,
            "fill": "#fffdf8",
            "stroke": "#17211b",
            "strokeWidth": 2,
            "opacity": 1
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            }
          },
          "transform": [
            {
              "filter": "datum.marker"
            }
          ]
        },
        {
          "transform": [
            {
              "filter": "datum.side === 'left'"
            }
          ],
          "mark": {
            "type": "text",
            "align": "right",
            "baseline": "middle",
            "dx": -10,
            "fontSize": 12.5,
            "fontWeight": 700,
            "lineBreak": "\n",
            "lineHeight": 15,
            "color": "#17211b",
            "stroke": "#fffdf8",
            "strokeWidth": 4,
            "strokeJoin": "round",
            "strokeOpacity": 0.9
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "text": {
              "field": "label"
            }
          }
        },
        {
          "transform": [
            {
              "filter": "datum.side === 'left'"
            }
          ],
          "mark": {
            "type": "text",
            "align": "right",
            "baseline": "middle",
            "dx": -10,
            "fontSize": 12.5,
            "fontWeight": 700,
            "lineBreak": "\n",
            "lineHeight": 15,
            "color": "#17211b"
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "text": {
              "field": "label"
            }
          }
        },
        {
          "transform": [
            {
              "filter": "datum.side === 'right'"
            }
          ],
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "middle",
            "dx": 10,
            "fontSize": 12.5,
            "fontWeight": 700,
            "lineBreak": "\n",
            "lineHeight": 15,
            "color": "#17211b",
            "stroke": "#fffdf8",
            "strokeWidth": 4,
            "strokeJoin": "round",
            "strokeOpacity": 0.9
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "text": {
              "field": "label"
            }
          }
        },
        {
          "transform": [
            {
              "filter": "datum.side === 'right'"
            }
          ],
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "middle",
            "dx": 10,
            "fontSize": 12.5,
            "fontWeight": 700,
            "lineBreak": "\n",
            "lineHeight": 15,
            "color": "#17211b"
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "text": {
              "field": "label"
            }
          }
        }
      ]
    }
  ],
  "config": {
    "background": null,
    "view": {
      "stroke": null
    },
    "font": "Source Sans 3",
    "axis": {
      "labelColor": "#5e6c63",
      "titleColor": "#17211b",
      "domainColor": "#cfc7b8",
      "gridColor": "#e8e2d6"
    },
    "legend": {
      "labelColor": "#49574e",
      "titleColor": "#17211b",
      "titleFontWeight": 700,
      "symbolStrokeWidth": 1
    }
  }
}
