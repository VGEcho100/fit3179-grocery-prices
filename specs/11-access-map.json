        {
          "name": "hoveredSA2",
          "select": {
            "type": "point",
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#ddd8cd",
        "stroke": "#fffdf8",
        "strokeWidth": 0.45
      },
      "encoding": {
        "shape": {
          "field": "geometry",
          "type": "geojson"
        }
      }
    },
    {
